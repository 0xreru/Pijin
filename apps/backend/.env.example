# Pijin - Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.

# ==============================================================================
# General & Debug
# ==============================================================================
NODE_ENV="development"
OFFLINE_TRANSACTION_DEBUG=true
DEMO_ENABLED=true
DEMO_ACCESS_CODE=""
DEMO_POOL_TARGET_PAIRS=14
DEMO_POOL_QA_PAIRS=2
DEMO_SESSION_TTL_HOURS=12
DEMO_POOL_ENCRYPTION_KEY=""
OFFLINE_EXPIRY_LEDGERS=300
CORS_ORIGIN="*"

# Backend Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# Database (PostgreSQL / Neon)
# ==============================================================================
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ==============================================================================
# Stellar & Soroban RPC Configurations
# ==============================================================================
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_HORIZON_TESTNET_URL="https://horizon-testnet.stellar.org"
STELLAR_HORIZON_MAINNET_URL="https://horizon.stellar.org"

# Pijin Core Contract & Token
CONTRACT_ID="CCGXMMXAYI4EHTGSH65ML3VK6TTRBQGT3BT2NN3P6Y3LGN6XIL2HILPX"
TOKEN_ID="CD26OANM4I4GF2GBC47UYTSP3FUBZRQ7WGMGECEQHMZ2D6QV2LXJTNIS"
OFFLINE_TOKEN_SYMBOL="PHPC"

# ==============================================================================
# Core Stellar Keypairs (Testnet placeholders - NEVER commit real production keys)
# ==============================================================================
# Relayer / Gateway Keypair
RELAYER_PUBLIC_KEY="G..."
RELAYER_SECRET_KEY="S..."

# Registrar Keypair
REGISTRAR_PUBLIC_KEY="G..."
REGISTRAR_SECRET_KEY="S..."

# Treasury Public Key
TREASURY_PUBLIC_KEY="G..."

# PHPC Issuer & Distributor
PHPC_ISSUER_PUBKEY="G..."
PHPC_DISTRIBUTOR_SECRET="S..."

# USDC Issuer & Distributor
USDC_ISSUER_PUBKEY="G..."
USDC_DISTRIBUTOR_SECRET="S..."

# ==============================================================================
# Textbee SMS Gateway Configuration
# ==============================================================================
TEXTBEE_GATEWAY_URL="https://api.textbee.dev/api/v1/gateway/devices/your-device-id/send-sms"
TEXTBEE_API_KEY="your-textbee-api-key"
TEXTBEE_DEVICE_ID="your-textbee-device-id"
TEXTBEE_WEBHOOK_SECRET="your-textbee-webhook-secret"
TEXTBEE_SIM_SUBSCRIPTION_ID=""
TEXTBEE_TIMEOUT_MS=4500
TEXTBEE_RETRIES=2
# Optional second device/SIM, tried automatically when the primary fails.
TEXTBEE_FALLBACK_DEVICE_ID=""
TEXTBEE_FALLBACK_GATEWAY_URL=""
TEXTBEE_FALLBACK_API_KEY=""
TEXTBEE_FALLBACK_SIM_SUBSCRIPTION_ID=""

# ==============================================================================
# Upstash QStash & Redis (Background Jobs & Rate Limiting)
# ==============================================================================
QSTASH_URL="https://qstash-region.upstash.io"
QSTASH_TOKEN="your-qstash-bearer-token"
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."

UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# ==============================================================================
# Sign-up Security (OTP verification token)
# ==============================================================================
# HS256 secret for the 30-minute phone-verification token issued by /api/otp/verify.
OTP_VERIFICATION_JWT_SECRET="your-separate-otp-jwt-secret"
# Set to "true" only after the APK that sends verificationToken is installed by all testers.
REQUIRE_OTP_TOKEN=false
# Global cap on OTP SMS per hour (protects the TextBee SIM quota).
OTP_GLOBAL_LIMIT_PER_HOUR=300
# Tester fallback for SMS outages. Keep OFF unless TextBee is down on test day.
# Allow-listed numbers (comma-separated, any format) get OTP_TEST_CODE and no SMS.
OTP_TEST_MODE=false
OTP_TEST_NUMBERS=""
OTP_TEST_CODE=""

# ==============================================================================
# SEP-10: Stellar Web Authentication
# ==============================================================================
SECRET_SEP10_SIGNING_SEED="S..."
SECRET_SEP10_JWT_SECRET="your-32-byte-secret-hex-or-base64"
SEP10_HOME_DOMAINS="localhost:3000,pijin-api.vercel.app"
SEP10_AUTH_TIMEOUT=900
SEP10_JWT_TIMEOUT=86400

# ==============================================================================
# SEP-24: Interactive Deposit / Withdraw
# ==============================================================================
SECRET_SEP24_INTERACTIVE_URL_JWT_SECRET="your-separate-sep24-jwt-secret"

# ==============================================================================
# Fiat Ramp Controls (optional — defaults shown)
# ==============================================================================
# Global kill switch for SEP-24 deposits and withdrawals.
RAMP_ENABLED=true
DEPOSIT_ENABLED=true
WITHDRAW_ENABLED=true
# Per-transaction and rolling 24h per-user limits, in whole asset units.
RAMP_MAX_PER_TX_PHPC=5000
RAMP_DAILY_MAX_PER_USER_PHPC=20000
RAMP_MAX_PER_TX_USDC=100
RAMP_DAILY_MAX_PER_USER_USDC=400

# ==============================================================================
# Offline Settlement Overrides (optional)
# ==============================================================================
# Protocol toll in stroops. Defaults to 5000000 (0.5 PHPC) for PHPC, 0 otherwise.
# PROTOCOL_TOLL_STROOPS=5000000
