# Pijin - Backend Environment Variables
# Copy this file to .env and fill in the values for your environment.

# ==============================================================================
# General & Debug
# ==============================================================================
NODE_ENV="development"
OFFLINE_TRANSACTION_DEBUG=true
DEMO_ENABLED=true
DEMO_ACCESS_CODE=""
DEMO_POOL_TARGET_PAIRS=14
DEMO_POOL_QA_PAIRS=2
DEMO_SESSION_TTL_HOURS=12
DEMO_POOL_ENCRYPTION_KEY=""
OFFLINE_EXPIRY_LEDGERS=300
CORS_ORIGIN="*"

# Backend Host URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# Database (PostgreSQL / Neon)
# ==============================================================================
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ==============================================================================
# Stellar & Soroban RPC Configurations
# ==============================================================================
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_HORIZON_TESTNET_URL="https://horizon-testnet.stellar.org"
STELLAR_HORIZON_MAINNET_URL="https://horizon.stellar.org"

# Pijin Core Contract & Token
CONTRACT_ID="CCGXMMXAYI4EHTGSH65ML3VK6TTRBQGT3BT2NN3P6Y3LGN6XIL2HILPX"
TOKEN_ID="CD26OANM4I4GF2GBC47UYTSP3FUBZRQ7WGMGECEQHMZ2D6QV2LXJTNIS"
OFFLINE_TOKEN_SYMBOL="PHPC"

# ==============================================================================
# Core Stellar Keypairs (Testnet placeholders - NEVER commit real production keys)
# ==============================================================================
# Relayer / Gateway Keypair
RELAYER_PUBLIC_KEY="G..."
RELAYER_SECRET_KEY="S..."

# Registrar Keypair
REGISTRAR_PUBLIC_KEY="G..."
REGISTRAR_SECRET_KEY="S..."

# Treasury Public Key
TREASURY_PUBLIC_KEY="G..."

# PHPC Issuer & Distributor
PHPC_ISSUER_PUBKEY="G..."
PHPC_DISTRIBUTOR_SECRET="S..."

# USDC Issuer & Distributor
USDC_ISSUER_PUBKEY="G..."
USDC_DISTRIBUTOR_SECRET="S..."

# ==============================================================================
# Textbee SMS Gateway Configuration
# ==============================================================================
TEXTBEE_GATEWAY_URL="https://api.textbee.dev/api/v1/gateway/devices/your-device-id/send-sms"
TEXTBEE_API_KEY="your-textbee-api-key"
TEXTBEE_DEVICE_ID="your-textbee-device-id"
TEXTBEE_WEBHOOK_SECRET="your-textbee-webhook-secret"
TEXTBEE_SIM_SUBSCRIPTION_ID=""
TEXTBEE_TIMEOUT_MS=4500
TEXTBEE_RETRIES=2

# ==============================================================================
# Upstash QStash & Redis (Background Jobs & Rate Limiting)
# ==============================================================================
QSTASH_URL="https://qstash-region.upstash.io"
QSTASH_TOKEN="your-qstash-bearer-token"
QSTASH_CURRENT_SIGNING_KEY="sig_..."
QSTASH_NEXT_SIGNING_KEY="sig_..."

UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# ==============================================================================
# SEP-10: Stellar Web Authentication
# ==============================================================================
SECRET_SEP10_SIGNING_SEED="S..."
SECRET_SEP10_JWT_SECRET="your-32-byte-secret-hex-or-base64"
SEP10_HOME_DOMAINS="localhost:3000,pijin-api.vercel.app"
SEP10_AUTH_TIMEOUT=900
SEP10_JWT_TIMEOUT=86400

# ==============================================================================
# SEP-24: Interactive Deposit / Withdraw
# ==============================================================================
SECRET_SEP24_INTERACTIVE_URL_JWT_SECRET="your-separate-sep24-jwt-secret"
